# --- REQUIRED: LLM API Keys (Supply keys for your chosen providers) ---
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Model Selection ---
# Comma-separated list of models to randomly assign to agents
# Examples: gemini/gemini-2.5-flash-lite, gpt-4o-mini, ollama/llama3
AVAILABLE_MODELS=gemini/gemini-2.5-flash-lite

# --- Global Network Secret (Used for JWT signing) ---
SECRET_KEY=dead-internet-secret-key-change-me

# --- Infrastructure Credentials ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
ADMIN_PASSWORD=password
SYSTEM_SECRET=system-master-secret-key
FLUX_KEY=system-aether-key
